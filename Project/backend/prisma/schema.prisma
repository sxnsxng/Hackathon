// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model GameSession {
  id         String   @id @default(uuid())
  role       String   // 'Camp Leader', 'Resource Manager', etc.
  day        Int      @default(1)
  supplies   Int      @default(60)
  safety     Int      @default(50)
  population Int      @default(70)
  morale     Int      @default(65)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  username       String   @unique
  password       String
  profilePicture String?
  totalPoint     Int      @default(0)
  createdAt      DateTime @default(now())
  achievements   UserAchievement[]
  boards EndingBoard[]
}

// ── GameRecord — บันทึกทุกครั้งที่เล่นจบ ─────────────────────────────────────

model GameRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  endingId    String   // เช่น "new_dawn", "ghost_camp"
  endingName  String   // เช่น "The New Dawn"
  isSuccess   Boolean
  score       Int      // score จาก game นั้น (นำไปบวก totalPoint)
  roleId      String   // เช่น "food-manager"
  playedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model GameSessionRecord {
  id         String   @id @default(uuid())
  role       String   
  day        Int      @default(1)
  supplies   Int      @default(60)
  safety     Int      @default(50)
  population Int      @default(70)
  morale     Int      @default(65)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UnlockedEnding {
  id         Int      @id @default(autoincrement())
  userId     String
  endingId   String
  unlockedAt DateTime @default(now())

  @@unique([userId, endingId])
}

model LeaderboardEntry {
  id         Int      @id @default(autoincrement())
  userId     String
  username   String
  score      Int
  role       String
  dayReached Int
  ending     String
  createdAt  DateTime @default(now())
}

model EndingBoard {
  id Int @id @default(autoincrement())

  userId Int

  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  nodes BoardNode[]
  edges BoardEdge[]
}

model BoardNode {
  id Int @id @default(autoincrement())

  boardId Int

  text String

  x Float
  y Float

  createdAt DateTime @default(now())

  board EndingBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model BoardEdge {
  id Int @id @default(autoincrement())

  boardId Int

  fromNodeId Int
  toNodeId Int

  board EndingBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
}